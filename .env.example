# ==============================================================================
# CodePilot AI - Environment Configuration Example
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# GitHub OAuth App Registration
# ------------------------------------------------------------------------------
# Register at: https://github.com/settings/developers
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# ------------------------------------------------------------------------------
# Security & Token Encryption (AES-256-GCM & JWT)
# ------------------------------------------------------------------------------
# 32-byte hexadecimal or base64 key used to encrypt OAuth access tokens in the DB
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret string used to sign session JWTs (HMAC-SHA256)
JWT_SECRET=super-secret-jwt-signing-key-for-codepilot-ai-production

# ------------------------------------------------------------------------------
# Faculty Access Policies
# ------------------------------------------------------------------------------
# Comma-separated list of additional approved university domains (e.g. mit.edu,stanford.edu)
# Academic domains (.edu, .ac.in, .edu.in) are supported automatically.
ALLOWED_FACULTY_DOMAINS=mit.edu,stanford.edu,harvard.edu,ox.ac.uk,cam.ac.uk,iitb.ac.in

# ------------------------------------------------------------------------------
# Groq AI Inference
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
NEXT_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b
